# Crash capture must work before FBE /data is available.
on init
    mkdir /tmp/tombstones 0700 root root
    mkdir /tmp/anr 0700 root root
    mkdir /apex 0755 root root
    mkdir /apex/com.android.runtime 0755 root root
    symlink /system/bin /apex/com.android.runtime/bin
    start tombstoned

service tombstoned /system/bin/tombstoned
    disabled
    user root
    group root log readproc
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system/lib64:/sbin
    socket tombstoned_crash seqpacket 0666 root root
    socket tombstoned_intercept seqpacket 0666 root root
    socket tombstoned_java_trace seqpacket 0666 root root
